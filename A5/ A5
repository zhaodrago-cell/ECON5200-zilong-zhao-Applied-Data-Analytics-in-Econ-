        "def fetch_world_bank_indicator(indicator_code, indicator_name, start_year=2013, end_year=2019):\n",
        "    url = (\n",
        "        f\"https://api.worldbank.org/v2/country/all/indicator/{indicator_code}\"\n",
        "        f\"?format=json&per_page=20000\"\n",
        "    )\n",
        "\n",
        "    r = requests.get(url, timeout=60)\n",
        "    r.raise_for_status()\n",
        "    data = r.json()\n",
        "\n",
        "    if not isinstance(data, list) or len(data) < 2 or data[1] is None:\n",
        "        return None\n",
        "\n",
        "    rows = data[1]\n",
        "    out = []\n",
        "\n",
        "    for row in rows:\n",
        "        country = row.get(\"country\", {})\n",
        "        country_name = country.get(\"value\")\n",
        "        country_iso3 = row.get(\"countryiso3code\")\n",
        "        year = row.get(\"date\")\n",
        "        value = row.get(\"value\")\n",
        "\n",
        "        out.append({\n",
        "            \"country_code\": country_iso3,\n",
        "            \"country_name\": country_name,\n",
        "            \"year\": year,\n",
        "            indicator_name: value\n",
        "        })\n",
        "\n",
        "    temp = pd.DataFrame(out)\n",
        "\n",
        "    temp[\"year\"] = pd.to_numeric(temp[\"year\"], errors=\"coerce\")\n",
        "    temp = temp[(temp[\"year\"] >= start_year) & (temp[\"year\"] <= end_year)].copy()\n",
        "\n",
        "\n",
        "    temp = temp[temp[\"country_code\"].notna()].copy()\n",
        "    temp = temp[temp[\"country_code\"] != \"\"].copy()\n",
        "    temp = temp[temp[\"country_code\"] != \"\"]  # 冗余保护\n",
        "    temp = temp[temp[\"country_code\"] != \"NA\"].copy()\n",
        "\n",
        "    if temp.empty:\n",
        "        return None\n",
        "\n",
        "    temp[indicator_name] = pd.to_numeric(temp[indicator_name], errors=\"coerce\")\n",
        "\n",
        "    temp = (\n",
        "        temp.groupby([\"country_code\", \"country_name\"], as_index=False)[indicator_name]\n",
        "        .mean()\n",
        "    )\n",
        "\n",
        "    return temp\n",
        "\n",
        "\n",
        "records = []\n",
        "\n",
        "for code, name in indicators.items():\n",
        "    try:\n",
        "        temp = fetch_world_bank_indicator(code, name, START_YEAR, END_YEAR)\n",
        "        if temp is not None and not temp.empty:\n",
        "            records.append(temp)\n",
        "            print(f\"Downloaded: {code} -> {name} | rows = {len(temp)}\")\n",
        "        else:\n",
        "            print(f\"Skipped: {code} -> {name} | no usable data\")\n",
        "    except Exception as e:\n",
        "        print(f\"Failed: {code} -> {name} | {e}\")\n",
        "\n",
        "print(\"Number of successful indicator downloads:\", len(records))\n",
        "\n",
        "if len(records) == 0:\n",
        "    raise ValueError(\"No indicators were downloaded successfully.\")"
      ],
