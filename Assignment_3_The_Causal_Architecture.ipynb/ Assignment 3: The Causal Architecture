      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Define datasets for love plot\n",
        "df_unmatched = psm_df.copy()\n",
        "df_matched = pd.concat([matched_treated, matched_control], axis=0).reset_index(drop=True)\n",
        "\n",
        "covariates = [\"pre_spend\", \"account_age\", \"support_tickets\"]\n",
        "treatment_col = \"subscriber\"\n",
        "\n",
        "def compute_smd(df, treatment_col, covariates):\n",
        "    treated = df[df[treatment_col] == 1]\n",
        "    control = df[df[treatment_col] == 0]\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for var in covariates:\n",
        "        mean_t = treated[var].mean()\n",
        "        mean_c = control[var].mean()\n",
        "        std_t = treated[var].std(ddof=1)\n",
        "        std_c = control[var].std(ddof=1)\n",
        "\n",
        "        pooled_std = np.sqrt((std_t**2 + std_c**2) / 2)\n",
        "\n",
        "        if pooled_std == 0 or np.isnan(pooled_std):\n",
        "            smd = 0.0\n",
        "        else:\n",
        "            smd = (mean_t - mean_c) / pooled_std\n",
        "\n",
        "        results.append({\n",
        "            \"covariate\": var,\n",
        "            \"smd\": smd,\n",
        "            \"abs_smd\": abs(smd)\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(results)\n",
        "\n",
        "smd_before = compute_smd(df_unmatched, treatment_col, covariates)\n",
